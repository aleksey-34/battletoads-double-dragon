# Copy to /opt/battletoads-double-dragon/.env on VPS (NEVER commit real .env)

NODE_ENV=production
PORT=3001

# Admin dashboard login (also seeds backend/.auth-password.json on restore)
DASHBOARD_PASSWORD=change_me_strong_password

# Client sessions / magic links
JWT_SECRET=change_me_long_random_string
CLIENT_BASE_URL=https://battletoads.top
APP_BASE_URL=https://battletoads.top

# SQLite paths (defaults: backend/database.db)
# DB_FILE=/opt/battletoads-double-dragon/backend/database.db
# RESEARCH_DB_PATH=/opt/battletoads-double-dragon/backend/research.db

# Deploy from admin UI / update script
ENABLE_GIT_UPDATE=1
DEPLOY_MODE=multi
SYNC_FRONTEND_NGINX=1
RESTART_RUNTIME=1
RESTART_RESEARCH=1
ALLOW_DIRTY_TRACKED=1

# New VPS public IP (exchange API whitelist)
VPS_PUBLIC_IP=
BTDD_EGRESS_IP=

# Admin API token (Settings → git deploy)
ADMIN_PLATFORM_TOKEN=

# Telegram admin alerts
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# Password recovery via Telegram
RECOVERY_TELEGRAM_BOT_TOKEN=
RECOVERY_TELEGRAM_CHAT_ID=

# Partner cabinet
PARTNER_VIEW_TOKEN=
PARTNER_TENANT_SLUG_PREFIXES=artursk

# Runtime tuning
STRATEGY_AUTORUN_SEC=30
MONITORING_SNAPSHOT_SEC=300
RECONCILIATION_INTERVAL_MIN=360
CT_REENTRY_MIN_BARS=3

# Split services (set in systemd units, optional overrides)
# BTDD_DISABLE_TRADING=1        # btdd-api only
# BTDD_DISABLE_RESEARCH_WORKERS=1
